@using System.IO.Compression
@using BigBang1112.GbxTools.IO.Data
@using ByteSizeLib
@using GBX.NET
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop

@inject ToolService ToolService
@inject IJSRuntime JS
@inject IDownloadService DownloadService

@{
    var ioTool = Tool is null ? null : ToolService.GetTool(Tool);
}

<PageTitle>@GetTitle()</PageTitle>

<ReuUploadScreen OnUpload="ImportAsync" Accept="@GetAccept(ioTool)"></ReuUploadScreen>
<ReuMain>
    <ToolMenu SelectedToolEndpoint="@Tool" SelectedToolChanged="OnSelectedToolChanged"></ToolMenu>
    <div class="io-upload-area">
        @if (ioTool is null)
        {
            <h1>Please select a tool</h1>
        }
        else
        {
            <h1>@ioTool.Name</h1>
            <div class="input-output">
                <div class="gbx-item">
                    <img src="@GetFileIconPath(ioTool.InputExtensions)" alt="Gbx" class="@(ioTool.InputExtensions.Any(x => x.EndsWith("gbx", StringComparison.OrdinalIgnoreCase) && !x.EndsWith("pack.gbx", StringComparison.OrdinalIgnoreCase)) ? "gbx" : "")" width="128" height="128" />
                    <div class="extensions">
                        @foreach (var extension in ioTool.InputExtensions)
                        {
                            <div>*.@extension</div>
                        }
                    </div>
                </div>
                <img src="@GetIconPath("arrow_right.svg")" class="arrow" />
                @if (cts is null)
                {
                    <ReuUploadButton CssClass="upload-button" OnUpload="ImportAsync" Accept="@GetAccept(ioTool)">
                        <img src="@GetIconPath("upload.svg")" alt="Upload" />
                    </ReuUploadButton>                    
                }
                else
                {
                    <ReuButton OnClick="() => cts?.Cancel()" Variant="ReuButtonVariant.Red" CssClass="upload-button">Cancel</ReuButton>
                }
                <img src="@GetIconPath("arrow_right.svg")" class="arrow" />
                <div class="gbx-item">
                    <img src="@GetFileIconPath(ioTool.OutputExtensions)" alt="Gbx" class="@(ioTool.OutputExtensions.Any(x => x.EndsWith("gbx", StringComparison.OrdinalIgnoreCase) && !x.EndsWith("pack.gbx", StringComparison.OrdinalIgnoreCase)) ? "gbx" : "")" width="128" height="128" />
                    <div class="extensions">
                        @foreach (var extension in ioTool.OutputExtensions)
                        {
                            <div>*.@extension</div>
                        }
                    </div>
                </div>
            </div>
            <div class="drag-drop-note">...or drag & drop anywhere</div>
            <div class="status">
                @Message
            </div>
            <div class="extras">
                <ReuButton Enable="false">API</ReuButton>
                <ReuButton OnClick="() => logsOpen = true">Logs</ReuButton>
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="error-message">
                        @ErrorMessage
                    </div>
                }
            </div>
        }
    </div>
</ReuMain>
<ReuModal @bind-IsOpen="logsOpen" Title="@($"Logs{(ioTool is null ? null : $" - {ioTool.Name}")}")" MaxWidth="100%" Height="100%">
    @if (ioTool is not null)
    {
        <ReuLogs Provider="GetOrCreateProvider(ioTool.Endpoint)" style="height: 100%; box-sizing: border-box;"></ReuLogs>                
    }
</ReuModal>

    @code {
    private bool logsOpen = false;
    private Dictionary<string, ReuLoggerProvider> logProviders = [];
    private CancellationTokenSource? cts;

    [Parameter, EditorRequired]
    public string? Tool { get; set; }

    public string Message { get; set; } = string.Empty;
    public string ErrorMessage { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.gbxIo.scrollToolMenuToActive");
        }
    }

    ReuLoggerProvider GetOrCreateProvider(string toolEndpoint)
    {
        if (!logProviders.TryGetValue(toolEndpoint, out var provider))
        {
            provider = new ReuLoggerProvider();
            logProviders[toolEndpoint] = provider;
        }
        return provider;
    }

    string GetAccept(IoTool? ioTool)
    {
        return string.Join(',', ioTool?.InputExtensions.Select(e => $".{e}") ?? []);
    }

    string GetIconPath(string filePath)
    {
        return $"_content/BigBang1112.GbxTools.IO/icons/{filePath}";
    }

    string GetFileIconPath(IEnumerable<string> extensions)
    {
        foreach (var extension in extensions)
        {
            if (extension.EndsWith("gbx", StringComparison.OrdinalIgnoreCase))
            {
                return GetIconPath("gbx.png");
            }

            if (extension.EndsWith("pak", StringComparison.OrdinalIgnoreCase) || extension.EndsWith("zip", StringComparison.OrdinalIgnoreCase))
            {
                return GetIconPath("folder_zip.svg");
            }
        }

        return GetIconPath("file_export.svg");
    }

    string GetTitle()
    {
        var title = "Gbx I/O";
        var toolName = string.IsNullOrEmpty(Tool)
            ? null : ToolService.GetTool(Tool)?.Name;

        if (toolName is not null)
        {
            title += $" - {toolName}";
        }

        return title;
    }

    async Task OnSelectedToolChanged(IoTool tool)
    {
        Tool = tool.Endpoint;
        Message = string.Empty;
        ErrorMessage = string.Empty;

        await JS.InvokeVoidAsync("history.pushState", null, "", $"/{tool.Endpoint}");
    }

    async Task ImportAsync(UploadEventArgs args)
    {
        if (Tool is null)
        {
            return;
        }

        var tool = ToolService.GetTool(Tool);
        if (tool is null)
        {
            return;
        }

        tool.Progress = new Progress<string>(async msg =>
        {
            if (cts is null or { IsCancellationRequested: true })
            {
                return;
            }

            Message = msg;
            StateHasChanged();
            await Task.Yield();
        });

        var logger = GetOrCreateProvider(tool.Endpoint).CreateLogger(tool.Endpoint);
        logger.LogInformation("Received file {FileName} ({FileSize}) for tool {ToolName}", args.FileName, ByteSize.FromBytes(args.Data.Length), tool.Name);

        cts = new CancellationTokenSource();

        var cancellationToken = cts.Token;

        try
        {
            if (args.Type == "application/zip")
            {
                logger.LogInformation("Received ZIP file, extracting and processing each entry for tool {ToolName}", tool.Name);

                await using var msInput = new MemoryStream(args.Data);
                using var zipInput = new ZipArchive(msInput, ZipArchiveMode.Read);

                var msOutput = new MemoryStream();
                using (var zipOutput = new ZipArchive(msOutput, ZipArchiveMode.Create, leaveOpen: true))
                {
                    foreach (var entry in zipInput.Entries)
                    {
                        logger.LogInformation("Processing entry {EntryName} from ZIP file for tool {ToolName}", entry.FullName, tool.Name);
                        
                        await using var entryStream = entry.Open();
                        var binData = new BinData(args.FileName, entryStream, args.Type);

                        try
                        {
                            var output = await ToolService.ProcessFileAsync(tool.Endpoint, binData, logger, cancellationToken);

                            await foreach (var fileData in ProcessOutputAsync(output))
                            {
                                await using var stream = zipOutput.CreateEntry(fileData.FileName).Open();
                                await fileData.Stream.CopyToAsync(stream);
                            }
                        }
                        catch (Exception ex)
                        {
                            logger.LogError(ex, "Error processing entry {EntryName} from ZIP file for tool {ToolName}", entry.FullName, tool.Name);
                            ErrorMessage = ex.Message;
                        }
                    }
                }

                msOutput.Position = 0; // TODO really needed?

                await DownloadService.DownloadAsync($"{Path.GetFileNameWithoutExtension(args.FileName)}.zip", msOutput);
            }
            else
            {
                logger.LogInformation("Processing single file {FileName} for tool {ToolName}", args.FileName, tool.Name);

                var binData = new BinData(args.FileName, new MemoryStream(args.Data), args.Type);

                var output = await ToolService.ProcessFileAsync(tool.Endpoint, binData, logger, cancellationToken);

                await foreach (var fileData in ProcessOutputAsync(output))
                {
                    await DownloadService.DownloadAsync(fileData.FileName, fileData.Stream);
                }
            }

            logger.LogInformation("Tool {ToolName} completed successfully for {FileName}", tool.Name, args.FileName);
        }
        catch (OperationCanceledException)
        {
            logger.LogWarning("Tool {ToolName} canceled for {FileName}", tool.Name, args.FileName);
            Message = "Tool canceled.";
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error processing file {FileName} for tool {ToolName}", args.FileName, tool.Name);
            ErrorMessage = ex.Message;
        }

        cts = null;
    }

    async IAsyncEnumerable<IData> ProcessOutputAsync(object? output)
    {
        if (output is IEnumerable<object> enumerable)
        {
            foreach (var item in enumerable)
            {
                await foreach (var dataInEnumerable in ProcessOutputAsync(item))
                {
                    yield return dataInEnumerable;
                }
            }
        }

        if (output is IData data)
        {
            data.Stream.Position = 0;
            yield return data;
        }

        if (output is Gbx gbx)
        {
            var ms = new MemoryStream();
            gbx.Save(ms);
            ms.Position = 0;
            yield return new GbxData(gbx.FilePath, ms);
        }
    }
}