@using Microsoft.JSInterop

@inject ToolService ToolService
@inject IJSRuntime JS

<PageTitle>@GetTitle()</PageTitle>

<ReuUploadScreen></ReuUploadScreen>
<ReuMain>
    <ToolMenu SelectedToolEndpoint="@Tool" SelectedToolChanged="OnSelectedToolChanged"></ToolMenu>
    <div class="io-upload-area">
        <ReuUploadButton>Upload via this button</ReuUploadButton>
    </div>
</ReuMain>

@code {
    [Parameter, EditorRequired]
    public string? Tool { get; set; }

    string GetTitle()
    {
        var title = "Gbx I/O";
        var toolName = string.IsNullOrEmpty(Tool)
            ? null : ToolService.GetTool(Tool)?.Name;

        if (toolName is not null)
        {
            title += $" - {toolName}";
        }

        return title;
    }

    private async Task OnSelectedToolChanged(IoTool tool)
    {
        Tool = tool.Name;

        await JS.InvokeVoidAsync("history.pushState", null, "", $"/{tool.Endpoint}");
    }
}